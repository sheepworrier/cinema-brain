<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cinemabrain.daily-ratings</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/djp42/code/cinema_brain/run_daily.sh</string></array>
  <!-- Every day 08:00. If the Mac is asleep then, launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/djp42/Library/Logs/cinemabrain.daily.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/djp42/Library/Logs/cinemabrain.daily.launchd.log</string>
</dict>
</plist>
